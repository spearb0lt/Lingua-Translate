# Copy to .env and edit. Every value here is the default unless noted.

# --- edition -------------------------------------------------------------
LINGUA_EDITION=full          # full | lite   (lite = no local models)
LINGUA_LOCAL=1               # 0 disables local models even in the full edition

# --- local models --------------------------------------------------------
LINGUA_DEVICE=auto           # auto | cuda | cpu
                             # auto drops to CPU below 1.2 GB free VRAM rather
                             # than dying with an OOM mid-request
LINGUA_MODEL_CACHE=2         # how many models stay resident (LRU eviction)
LINGUA_MODEL_DIR=            # where weights live; default ~/.cache/lingua-models
LINGUA_LOCAL_TIMEOUT=120     # seconds before a local model falls through
LINGUA_PRELOAD=              # 1 warms models at startup instead of first request
LINGUA_IT2_BEAMS=5
LINGUA_NLLB_REPO=facebook/nllb-200-distilled-600M

# --- routing -------------------------------------------------------------
LINGUA_MAX_TIER=FREEMIUM     # LOCAL | FREE_WEB | FREE_API | FREEMIUM
                             # set LOCAL to guarantee nothing leaves the machine

# --- speech --------------------------------------------------------------
LINGUA_WHISPER_MODEL=small   # tiny | base | small | medium | large-v3
LINGUA_WHISPER_COMPUTE=      # default int8_float16 on CUDA, int8 on CPU
LINGUA_MAX_AUDIO_MB=25

# --- free API tiers ------------------------------------------------------
MYMEMORY_EMAIL=              # raises the free quota from ~5k to ~50k words/day
LIBRETRANSLATE_URL=          # your own instance = unlimited free fallback
LIBRETRANSLATE_API_KEY=

# --- server --------------------------------------------------------------
LINGUA_LOG_LEVEL=INFO
LINGUA_CORS_ORIGINS=*
LINGUA_MAX_TEXT_CHARS=20000
